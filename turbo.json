{
  "$schema": "https://v2-10-9.turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.json", "biome.json", "pnpm-workspace.yaml", "pnpm-lock.yaml", "scripts/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "tests/**",
        "tsconfig*.json",
        "playwright.config.ts",
        "vite.config.*",
        "pages/**",
        "public/**",
        "index.html",
        "build.mjs",
        "package.json",
        "package.override.json"
      ],
      "outputs": ["dist/**", "build/**", ".npm-pkg/**"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "src/**",
        "test/**",
        "tests/**",
        "vitest.config.ts",
        "vitest.setup.ts",
        "../shadow-objects/vitest.setup.ts",
        "playwright.config.ts",
        "pages/**",
        "public/**",
        "index.html",
        "package.json"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "tests/**", "tsconfig*.json", "playwright.config.ts"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "watch": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "publishNpmPkg": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "passThroughEnv": [
        "ACTIONS_ID_TOKEN_REQUEST_URL",
        "ACTIONS_ID_TOKEN_REQUEST_TOKEN",
        "GITHUB_*",
        "NPM_CONFIG_*",
        "NODE_AUTH_TOKEN",
        "NPM_TOKEN"
      ]
    }
  }
}